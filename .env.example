# Cafe24 개발자센터에서 발급한 값입니다. 실제 값을 저장소에 커밋하지 마세요.
CAFE24_CLIENT_ID=replace_with_cafe24_client_id
CAFE24_CLIENT_SECRET=replace_with_cafe24_client_secret

# 실제 운영 도메인입니다. Dokploy에서는 SvelteKit이 외부 HTTPS origin을 인식하는 데 사용합니다.
ORIGIN=https://your-app.example.com

# Cafe24 앱 설정에 등록한 OAuth Redirect URI와 완전히 같아야 합니다.
CAFE24_REDIRECT_URI=https://your-app.example.com/auth/callback

# Cafe24 Admin API Version header. 생략하면 앱 기본값 2026-06-01을 사용합니다.
CAFE24_API_VERSION=2026-06-01

# 첫 번째 항목이 현재 암호화 키이며, 뒤의 항목은 기존 envelope 복호화용입니다.
# 형식: kid:base64url-encoded-32-byte-key[,old-kid:old-key]
# 키 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CAFE24_TOKEN_ENCRYPTION_KEYS=v1:replace_with_32_byte_base64url_key

# OAuth state HMAC 전용 secret입니다. 생략 시 CAFE24_CLIENT_SECRET을 사용합니다.
CAFE24_OAUTH_STATE_SECRET=replace_with_random_secret

# 로컬 개발에서만 true로 허용됩니다. production에서는 반드시 false입니다.
CAFE24_SKIP_HMAC_CHECK=false
